local fs = require("system/fs")
local path = require("system/path")
local Util = require("./Util")
local Source = require("./Source")
local Json = require("./Json")
local Lockfile = require("./Lockfile")
local Installer = {}
local marker = "xtpkg-packages-v2\n"
local function checkOwned(directory, previous)
    if not fs.exists(directory) then return end
    Util.noLinksTree(directory)
    local ownership = path.join(directory, ".xtpkg-owned")
    if fs.exists(ownership) and fs.readSync(ownership) == marker then return end
    local children = fs.readDir(directory):await()
    if #children == 0 then return end
    if previous and previous.legacy then
        for _, child in ipairs(children) do
            if not previous.packages[child] or not fs.stat(path.join(directory, child)):await().isDirectory then error("Unmanaged files in packages/; move them before installing", 0) end
        end
        return
    end
    error("Refusing to overwrite unmanaged packages/. Move it or restore its .xtpkg-owned marker.", 0)
end
function Installer.install(directory, previous, lock, options)
    options = options or {}
    Util.noLinks(directory)
    local destination = path.join(directory, "packages"); checkOwned(destination, previous)
    local stage = path.join(directory, ".xtpkg-stage-" .. Util.id())
    fs.mkdir(stage, false):await()
    local rollbacks, committed = {}, false
    local ok, err = pcall(function()
        local stagedPackages = path.join(stage, "packages"); Util.mkdir(stagedPackages)
        local imports, count = {}, 0
        for _, name in ipairs(Util.keys(lock.packages)) do
            local p = lock.packages[name]
            -- Flat namespace: an unscoped package cannot also be a scope.
            local scope = name:match("^([^/]+)/")
            if scope and lock.packages[scope] then error("Install layout conflict: " .. scope .. " is both a package and a scope", 0) end
            if options.log then options.log("  + " .. name .. "@" .. p.version) end
            if not p.integrity and options.log then options.log("    No registry checksum supplied; verifying the exact Git commit and recording a local checksum. Publisher identity is not authenticated.") end
            local snapshot = Source.obtain(p, options)
            local manifest = Source.validate(snapshot, { name = name, version = p.version, integrity = p.integrity, entry = p.entry, dependencies = p.requirements })
            p.integrity, p.entry = snapshot.integrity, manifest.package.entry
            local packageDir = path.join(stagedPackages, name)
            for _, file in ipairs(Util.keys(snapshot.files)) do
                local target = path.join(packageDir, file)
                Util.mkdir(path.dirname(target)); fs.writeSync(target, snapshot.files[file])
            end
            local wrapper = path.join(stagedPackages, name .. ".luau")
            Util.mkdir(path.dirname(wrapper))
            fs.writeSync(wrapper, "-- Generated by XTPKG.\nreturn require(" .. Json.encode("./" .. path.basename(name) .. "/" .. p.entry) .. ")\n")
            imports[name] = { path = "./" .. name, entry = p.entry, version = p.version, revision = p.revision }
            count += 1
        end
        fs.writeSync(path.join(stagedPackages, ".xtpkg-owned"), marker)
        fs.writeSync(path.join(stagedPackages, ".xtpkg-imports.json"), Json.encode(imports) .. "\n")
        local module = { "-- Generated named-import adapter for LuauXTX's relative require API.", "local runtimeRequire = require", "local paths = {" }
        for _, name in ipairs(Util.keys(imports)) do table.insert(module, "  [" .. Json.encode(name) .. "] = " .. Json.encode(imports[name].path) .. ",") end
        table.insert(module, "}\nreturn { require = function(name)\n  local p = paths[name]\n  assert(p, 'Package is not installed: ' .. tostring(name))\n  return runtimeRequire(p)\nend }\n")
        fs.writeSync(path.join(stagedPackages, ".xtpkg-imports.luau"), table.concat(module, "\n"))
        local renderedLock = Lockfile.render(lock)
        if options.locked and Lockfile.render(Lockfile.load(directory)) ~= renderedLock then error("--locked forbids lockfile changes; run xtpkg install without --locked", 0) end
        if not options.locked then fs.writeSync(path.join(stage, "xtpkg.lock"), renderedLock) end
        if options.manifestText then fs.writeSync(path.join(stage, "xtpkg.toml"), options.manifestText) end
        local function replace(name)
            local target, staged, backup = path.join(directory, name), path.join(stage, name), path.join(stage, "backup-" .. name)
            Util.noLinks(target)
            if fs.exists(target) then
                fs.rename(target, backup):await()
                table.insert(rollbacks, function() if fs.exists(target) then Util.remove(target) end; fs.rename(backup, target):await() end)
            else table.insert(rollbacks, function() Util.remove(target) end) end
            fs.rename(staged, target):await()
        end
        replace("packages")
        if not options.locked then replace("xtpkg.lock") end
        if options.manifestText then replace("xtpkg.toml") end
        committed = true
        if options.log then options.log("Installed " .. count .. " package" .. (count == 1 and "" or "s")) end
    end)
    if not ok and not committed then
        local rollbackErrors = {}
        for i = #rollbacks, 1, -1 do local restored, detail = pcall(rollbacks[i]); if not restored then table.insert(rollbackErrors, tostring(detail)) end end
        if #rollbackErrors > 0 then error(tostring(err) .. "\nRollback needs manual recovery from " .. stage .. ": " .. table.concat(rollbackErrors, "; "), 0) end
    end
    local clean, detail = pcall(function() Util.noLinksTree(stage); Util.remove(stage) end)
    if not ok then error(err, 0) end
    if not clean and options.log then options.log("Installation succeeded; temporary backup cleanup failed: " .. tostring(detail)) end
end
return Installer
